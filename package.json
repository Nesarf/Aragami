{
  "name": "aragami",
  "version": "0.1.0",
  "description": "Portable static posture audit for Tor Browser and Firefox across five layers: build, transport, content/authorization, metadata, endpoint. Read-only, and the layer assessment is explicit about what no tool can solve.",
  "type": "module",
  "main": "mcp/index.mjs",
  "bin": {
    "aragami": "./cli/index.mjs",
    "aragami-mcp": "./mcp/index.mjs"
  },
  "mcp": {
    "server": {
      "command": "aragami-mcp",
      "args": []
    }
  },
  "files": [
    "bin",
    "lib",
    "mcp",
    "cli",
    "test",
    "README.md",
    "LICENSE",
    "Aragami"
  ],
  "scripts": {
    "test": "node test/net.mjs && node test/matrix.mjs && node test/mcp-smoke.mjs && node test/firefox.mjs && node test/selftest.mjs && node test/emblem.mjs",
    "test:core": "node test/selftest.mjs",
    "test:net": "node test/net.mjs",
    "test:matrix": "node test/matrix.mjs",
    "test:mcp": "node test/mcp-smoke.mjs",
    "test:firefox": "node test/firefox.mjs",
    "test:emblem": "node test/emblem.mjs",
    "test:cov": "node test/coverage.mjs",
    "audit": "node cli/index.mjs aragami_audit --human",
    "env": "node cli/index.mjs aragami_env --human",
    "version": "node cli/index.mjs aragami_version --human",
    "mcp": "node mcp/index.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nesarf/Aragami.git"
  },
  "homepage": "https://github.com/Nesarf/Aragami#readme",
  "bugs": {
    "url": "https://github.com/Nesarf/Aragami/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cli",
    "tor",
    "tor-browser",
    "privacy",
    "metadata",
    "audit",
    "aragami",
    "portable"
  ],
  "license": "MIT",
  "author": "Nesarf <Nesarf@users.noreply.github.com>",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
